# Copy to .env and adjust for your machine / emulator.
# Android emulator: http://10.0.2.2:8000/api/v1
# iOS simulator:    http://127.0.0.1:8000/api/v1
# Physical device:  http://YOUR_LAN_IP:8000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.0.25:8000/api/v1

# ── Push (FCM) — see docs/FIREBASE-PUSH-AR.md ──
# 1) Firebase Console → Android app com.clinic.system → google-services.json → mobile/
# 2) Service account JSON → storage/app/firebase-credentials.json
# 3) Laravel .env: PUSH_ENABLED=true + FIREBASE_PROJECT_ID
# 4) Verify: bash scripts/verify-firebase-setup.sh
# 5) Build APK (NOT Expo Go): npm run build:apk:cloud
