# Copy to .env and adjust for your machine / emulator.
# Android emulator: http://10.0.2.2:8000/api/v1
# iOS simulator:    http://127.0.0.1:8000/api/v1
# Physical device:  http://YOUR_LAN_IP:8000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.0.25:8000/api/v1

# ── Push (FCM) — requires APK / dev build, NOT Expo Go ──
# 1) Laravel .env: PUSH_ENABLED=true + FIREBASE_* (see repo .env.example)
# 2) Firebase Console → Android app com.clinic.system → download google-services.json
#    Place at mobile/google-services.json (gitignored) OR upload FCM key via: eas credentials
# 3) php artisan queue:work  (push jobs use queue)
#
# ── Build APK (EAS cloud) ──
#   cd mobile
#   npx eas-cli login
#   npx eas-cli build:configure   # first time only
#   npm run build:apk:cloud
#
# Update EXPO_PUBLIC_API_URL in eas.json preview profile to your LAN IP before building.
