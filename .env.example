# =============================================================================
# Clinic System — environment template
# Copy to .env and set values. Never commit .env to version control.
# =============================================================================

# --- Application (local development defaults) ---
APP_NAME="Clinic System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Platform super-admin (required in production for /platform and /admin routes)
# After first deploy: php artisan db:seed --class=RolePermissionSeeder
PLATFORM_OWNER_EMAIL=super@clinic.local
# Production: strong unique password (min 12 chars). Never use "password".
PLATFORM_OWNER_PASSWORD=
SEED_ALLOW_INSECURE=false
SEED_DEMO_DATA=false
SEED_ADMIN_EMAIL=admin@clinic.local
SEED_ADMIN_PASSWORD=
PLATFORM_OWNER_NAME="Platform Owner"
# Days before subscription_expires_at to flag "expiring soon" on dashboard and filters
PLATFORM_EXPIRING_SOON_DAYS=7
PLATFORM_NOTIFY_OWNER_MANUAL_PAYMENT=true

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ---
# Production: LOG_LEVEL=warning or error, LOG_STACK=daily
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Local default: SQLite. Production: use PostgreSQL (recommended) or MySQL.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=clinic_production
# DB_USERNAME=clinic_app
# DB_PASSWORD=

# Optional: full paths to backup CLI tools if not in PATH
# BACKUP_PG_DUMP_PATH="C:/Program Files/PostgreSQL/18/bin/pg_dump.exe"
# BACKUP_PG_RESTRICT_KEY=clinicbackupkey
# BACKUP_MYSQLDUMP_PATH=
# BACKUP_SQLITE3_PATH=
# BACKUP_SCHEDULE_ENABLED=true
# BACKUP_SCHEDULE_TIME=02:00
# BACKUP_RETENTION_DAYS=14
# BACKUP_NOTIFY_ENABLED=true
# BACKUP_NOTIFY_EMAILS=admin@example.com
# BACKUP_NOTIFY_WHATSAPP=972597360027

# LANDING_DEMO_VIDEO_URL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID
# LANDING_DEMO_VIDEO_EMBED=

# Mobile API (Sanctum Bearer tokens)
# SANCTUM_MOBILE_TOKEN_DAYS=30
# MOBILE_API_VERSION=1.0.0
# MOBILE_MIN_APP_VERSION=1.0.0

# Push (Firebase Cloud Messaging HTTP v1)
# PUSH_ENABLED=true
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json
# PUSH_QUEUE=default

# --- Session (production: consider redis + SESSION_ENCRYPT=true) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Queue (production: redis + Horizon; see docs/PHASE5_PERFORMANCE.md) ---
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

# --- Cache (production: redis recommended at scale) ---
CACHE_STORE=database
# CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (production: use a real provider, not log) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Stripe / Laravel Cashier (SaaS subscriptions) ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Subscription expiry reminders (email + in-app); requires scheduler: saas:send-subscription-reminders
SAAS_SUBSCRIPTION_REMINDERS=true
SAAS_SUBSCRIPTION_REMINDER_DAYS=7,3
SAAS_SUBSCRIPTION_REMINDER_EMAIL=true
SAAS_SUBSCRIPTION_REMINDER_IN_APP=true
SAAS_STRIPE_INVOICES_LIMIT=12
SAAS_ALLOW_PROMOTION_CODES=true
SAAS_WEBHOOK_LOG_ENABLED=true
SAAS_WEBHOOK_LOG_KEEP=30
SAAS_WEBHOOK_LOG_DISPLAY=8

# Public support / contact page (optional)
SAAS_SUPPORT_EMAIL=
SAAS_SUPPORT_WHATSAPP=
SAAS_SUPPORT_PHONE=

# Appointment SMS reminders (patient phone required on chart)
REMINDERS_SMS_ENABLED=false
REMINDERS_SMS_DRIVER=log
REMINDERS_SMS_DEFAULT_COUNTRY=972
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PLAN_BASIC_PRICE_CENTS=2900
PLAN_PRO_PRICE_CENTS=7900
PLAN_PREMIUM_PRICE_CENTS=14900

DEFAULT_CLINIC_ID=1

# =============================================================================
# PRODUCTION CHECKLIST (set explicitly before go-live)
# =============================================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example
# PLATFORM_OWNER_EMAIL=owner@your-domain.example  (strong unique password via PLATFORM_OWNER_PASSWORD)
# DB_CONNECTION=pgsql  (+ credentials)
# SESSION_ENCRYPT=true
# LOG_LEVEL=warning
# MAIL_MAILER=smtp  (or postmark/resend/etc.)
# QUEUE_CONNECTION=redis  (+ run queue worker)
# CACHE_STORE=redis
# Configure Stripe live keys + webhook URL: https://your-domain.example/stripe/webhook
# Run: php artisan config:cache route:cache view:cache
# Cron: * * * * * php /path/to/artisan schedule:run
# See docs/DEPLOYMENT.md

# --- Security (Phase 4) ---
SECURITY_2FA_ISSUER="${APP_NAME}"
SECURITY_2FA_RECOVERY_CODES=8
SECURITY_TRUSTED_DEVICE_DAYS=30
SECURITY_2FA_ENFORCE_ROLES=admin,clinic_owner
# Set true when ready for production security
SECURITY_2FA_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
SECURITY_2FA_ENFORCE_PLATFORM_OWNER=false
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_ALLOW_VITE_DEV=true
SECURITY_ATTACHMENTS_DISK=local
SECURITY_UPLOAD_MAX_KB=10240
SECURITY_MALWARE_SCANNER=
SECURITY_LOGIN_FAILED_THRESHOLD=5
SECURITY_LOGIN_FAILED_WINDOW=15
SECURITY_LOGIN_NEW_IP_ALERT=true
HEALTH_CHECK_TOKEN=
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
EXPORTS_QUEUE=true

# --- PDF export (Headless Chrome = same as print; DomPDF = fallback) ---
# auto | browsershot | dompdf
PDF_DRIVER=browsershot
PDF_ALLOW_DOMPDF_FALLBACK=false
# Linux: apt install chromium-browser  OR  set full path
# PDF_CHROME_PATH=/usr/bin/chromium-browser
# PDF_NODE_PATH=/usr/bin/node
# Windows (Edge works if Chrome is not installed; use forward slashes in .env):
# PDF_CHROME_PATH="C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"
# PDF_NODE_PATH="C:/Program Files/nodejs/node.exe"
# After npm install: puppeteer is used by Browsershot (npm install puppeteer)
PDF_NO_SANDBOX=true
PDF_BROWSERSHOT_TIMEOUT=120
PDF_PHP_TIME_LIMIT=180
PDF_BROWSERSHOT_DELAY_MS=800

# --- Performance (Phase 5) ---
# SESSION_DRIVER=redis
CACHE_DASHBOARD_FINANCIAL_TTL=60
CACHE_DASHBOARD_ANALYTICS_TTL=120
CACHE_DASHBOARD_OPERATIONAL_TTL=45
CACHE_REPORT_DATA_TTL=90
SPA_FRAGMENT_CACHE_MAX=24
HORIZON_PATH=horizon
HORIZON_ALLOWED_EMAILS=
QUEUE_NOTIFICATIONS=default
QUEUE_REMINDERS=default
