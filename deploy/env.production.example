# =============================================================================
# Production .env — VPS clinic-system
# Copy: cp deploy/env.production.example .env
# Then run: bash scripts/setup-vps-production.sh
# =============================================================================

APP_NAME="Clinic System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://31.97.61.205

PLATFORM_OWNER_EMAIL=owner@clinic.local
PLATFORM_OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PLATFORM_OWNER_NAME="Platform Owner"
SEED_ALLOW_INSECURE=false
SEED_DEMO_DATA=false
SEED_ADMIN_EMAIL=admin@clinic.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# PostgreSQL (Docker service name = postgres)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clinic
DB_USERNAME=clinic
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@clinic.local"
MAIL_FROM_NAME="${APP_NAME}"

# Mobile API
SANCTUM_MOBILE_TOKEN_DAYS=30
MOBILE_API_VERSION=1.0.0
MOBILE_MIN_APP_VERSION=1.0.0

# Push — required for mobile notifications (see docs/FIREBASE-PUSH-AR.md)
PUSH_ENABLED=true
FIREBASE_PROJECT_ID=clinic-system-56227
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json
PUSH_QUEUE=default

# Stripe — optional until you enable online payments
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

SECURITY_2FA_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
SECURITY_CSP_ALLOW_VITE_DEV=false

PDF_DRIVER=dompdf
PDF_ALLOW_DOMPDF_FALLBACK=true
PDF_NO_SANDBOX=true

QUEUE_NOTIFICATIONS=default
QUEUE_REMINDERS=default

# Docker nginx port on host (80 = http://SERVER_IP)
APP_PORT=80

# Landing page — Android APK download button
MOBILE_ANDROID_APK_URL=https://expo.dev/artifacts/eas/oDShSAmKzS7hL3whoqCXLZ.apk
